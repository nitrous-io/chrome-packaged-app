form
  fieldset class={ error:animation-shake }
    h1.logo Nitrous.IO

    .form-group class={ error:has-error }
      Ember.TextField classNames="form-control input-lg" placeholder="Username" valueBinding="username" disabledBinding="loading"
    .form-group class={ error:has-error }
      Ember.TextField classNames="form-control input-lg" type="password" placeholder="Password" valueBinding="password" disabledBinding="loading"

    .form-group
      button.btn.btn-default.btn-block.btn-lg click="login" disabled=loading Sign In
    .form-group
      p
        a href={ AIO.host } target='_blank' Create an Account
