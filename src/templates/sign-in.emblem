form submit="signIn"
  fieldset class={ errorMessage:animation-shake }
    h1.logo Nitrous.IO

    .form-group class={ errorMessage:has-error }
      Em.TextField classNames="form-control input-lg" placeholder="Username" valueBinding="username" disabledBinding="isSaving"
    .form-group class={ errorMessage:has-error }
      Em.TextField classNames="form-control input-lg" type="password" placeholder="Password" valueBinding="password" disabledBinding="isSaving"

    .form-group
      if AIO.online
        button.btn.btn-default.btn-block.btn-lg disabled={signInButtonDisabled} Sign In
      else
        button.btn.btn-default.btn-block.btn-lg disabled='disabled' No Internet Connection
    .form-group
      p
        a href={signUpURL} class={AIO.offline:invisible} target='_blank' Create an Account
