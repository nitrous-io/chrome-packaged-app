.accordion-heading
  a.accordion-toggle data-toggle='collapse' data-parent='#boxes-list' click='collapseBox target="view"'
    div class={:state-orb state} title=stateForDisplay
    = name
.accordion-body.collapse
  .accordion-inner
    if controllable
      .btn-toolbar
        if running
          .btn-group
            button.btn.btn-primary click='openPage "ide" this' disabled={AIO.offline} IDE
          .btn-group
            button.btn.btn-default click='openPage "terminal" this' disabled={AIO.offline} Terminal
        .btn-group.pull-right
          button.btn.btn-default.dropdown-toggle data-toggle='dropdown' disabled={AIO.offline}
            i.icon-off
          ul.dropdown-menu
            if running
              li
                a click='openPage "settings" this' Settings
              li.divider
              li
                a click='doAction "restart" this' Restart
              li
                a click='doAction "stop" this' Shut Down
            if stopped
              li
                a click='doAction "start" this' Start
    else
      p = prettyState
