#toolbar
  .navbar
    .navbar-brand.logo Nitrous.IO
    p.loading-indicator.navbar-text class={view.loading:loading}
      i.icon-cog.icon-spin
    ul.nav.navbar-nav.pull-right
      li
        a href='#' click="refresh" class={AIO.offline:disabled}
          i.icon-refresh class={content.isLoading:icon-spin}
      li.dropdown
        a.dropdown-toggle data-toggle='dropdown' href='#'
          i.icon-ellipsis-vertical
        ul.dropdown-menu
          li.dropdown-header
            i.icon-bolt &nbsp;
            | N2O : {{ AIO.currentUser.freeN2O }} / {{ AIO.currentUser.maxN2O }}
          li class={AIO.offline:disabled}
            a href='#' click='openPage "n2oBonus"' Earn More N2O
          li class={AIO.offline:disabled}
            a href='#' click='openPage "invites"' Invites
          li.divider
          li class={AIO.offline:disabled}
            a href='#' click='openPage "newBox"'
              | New Box...
          li class={AIO.offline:disabled}
            a href='#' click='openPage "boxes"' Boxes
          li class={AIO.offline:disabled}
            a href='#' click='openPage "publicKeys"' Public Keys
          li.divider
          li class={AIO.offline:disabled}
            a href='#' click='openPage "accountSettings"' Account Settings
          li class={AIO.offline:disabled}
            a href='#' click='openPage "applications"' Applications
          li.divider
          li
            a href='#' click="signOut" Sign Out

  #user-info
    AIO.N2OGaugeView

#boxes-list
  .accordion
    each arrangedContent
      AIO.BoxView
