.accordion-group
  .accordion-heading
    a.accordion-toggle data-toggle='collapse' data-parent='#boxes-list' click="collapseBox boxId target='view'"
      div class={:state-orb state} title=stateForDisplay
      = name
  .accordion-body.collapse
    .accordion-inner
      if active
        .btn-toolbar
          if running
            .btn-group
              button.btn.btn-primary click="openIde this" IDE
            .btn-group
              button.btn.btn-default click="openTerminal this" Terminal
          .btn-group.pull-right
            button.btn.btn-default.dropdown-toggle data-toggle='dropdown'
              i.icon-off
            ul.dropdown-menu
              if running
                li
                  a click="openSettings this" Settings
                li.divider
                li
                  a click="doAction this 'restart'" Restart
                li
                  a click="doAction this 'stop'" Shut Down
              if stopped
                li
                  a click="doAction this 'start'" Start
      else
        p = stateForDisplay

