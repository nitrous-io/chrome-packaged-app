.panel.panel-primary
  .panel-heading
    h2.panel-title￿
      = name
  dl.dl-horizontal
    dt State
    dd = stateForDisplay
  dl.dl-horizontal
    dt Memory
    dd #{memory} MB
  dl.dl-horizontal
    dt Storage
    dd #{storage} MB
  dl.dl-horizontal
    dt Region
    dd #{region.description}
  dl.dl-horizontal
    dt Stack
    dd #{boxTemplate.name}

.btn-toolbar
  if running
    .btn-group
      button click="openIde" IDE
      button click="openSettings" Settings

    .btn-group
      button click="doAction 'stop'" Shut Down
      button click="doAction 'restart'" Restart

  if stopped
    .btn-group
      button click="doAction 'start'" Start
