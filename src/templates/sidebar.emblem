.navbar
  .navbar-brand Nitrous.IO
  ul.nav.navbar-nav.pull-right
    li.dropdown
      a.dropdown-toggle data-toggle='dropdown' href='#'
        i.icon-ellipsis-vertical
      ul.dropdown-menu
        li.dropdown-header
          i.icon-bolt &nbsp;
          | N2O : {{AIO.currentUser.free_n2o}} / {{AIO.currentUser.max_n2o}}
        li
          a click="openN2oBonus" Earn More N2O...
        li.divider
        li
          a click="openInvites" Invites
        li
          a click="openBoxes" Boxes
        li
          a click="openPublicKeys" Public Keys
        li.divider
        li
          a click="openAccountSettings" Account Settings
        li
          a click="openApplications" Applications
        li.divider
        li
          a click="signout" Sign Out

#user-info
  AIO.N2oGaugeView

#boxes-list.accordion
  each model
    AIO.BoxView
