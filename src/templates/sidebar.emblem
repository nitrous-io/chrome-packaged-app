.navbar
  .navbar-brand Nitrous.IO
  ul.nav.navbar-nav.pull-right
    li.dropdown
      a.dropdown-toggle data-toggle='dropdown' href='#'
        i.icon-ellipsis-vertical
      ul.dropdown-menu
        li.dropdown-header
          i.icon-bolt &nbsp;
          | N2O : {{AIO.currentUser.free_n2o}} / {{AIO.currentUser.max_n2o}}
        li
          a click="open 'n2o_bonus'" Earn More N2O...
        li.divider
        li
          a click="open 'invites'" Invites
        li
          a click="open 'boxes'" Boxes
        li
          a click="open 'public_keys'" Public Keys
        li.divider
        li
          a click="open 'account_settings'" Account Settings
        li
          a click="open 'applications'" Applications
        li.divider
        li
          a click="signout" Sign Out

#user-info.sidebar-col
  AIO.N2oGaugeView

#boxes-list.accordion
  each model
    AIO.BoxView

#boxes-footer.sidebar-col
  a click="open 'new_box'"
    i.icon-plus &nbsp;
    | New Box
  a click="refreshBoxes"
    i.icon-refresh &nbsp;
    | Refresh
