.navbar
  .navbar-brand Nitrous.IO
  ul.nav.navbar-nav.pull-right
    li
      a href='#' click="refreshBoxes"
        i.icon-refresh
    li.dropdown
      a.dropdown-toggle data-toggle='dropdown' href='#'
        i.icon-ellipsis-vertical
      ul.dropdown-menu
        li.dropdown-header
          i.icon-bolt &nbsp;
          | N2O : {{AIO.currentUser.free_n2o}} / {{AIO.currentUser.max_n2o}}
        li
          a href='#' click="open 'n2o_bonus'" Earn More N2O
        li
          a href='#' click="open 'invites'" Invites
        li.divider
        li
          a href='#' click="open 'new_box'"
            | New Box...
        li
          a href='#' click="open 'boxes'" Boxes
        li
          a href='#' click="open 'public_keys'" Public Keys
        li.divider
        li
          a href='#' click="open 'account_settings'" Account Settings
        li
          a href='#' click="open 'applications'" Applications
        li.divider
        li
          a href='#' click="signout" Sign Out

#user-info.sidebar-col
  AIO.N2oGaugeView

#boxes-list.accordion
  each model
    AIO.BoxView
