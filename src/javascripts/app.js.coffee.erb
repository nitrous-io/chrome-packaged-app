#= require unload-fix
#= require jquery/jquery-2.0.3
#= require handlebars
#= require ember
#= require pusher/pusher-2.1.2
#= require bootstrap3/js/bootstrap
#= require_self
#= require aio

appWindow = chrome.app.window.current()
appWindow.onBoundsChanged.addListener ->
  $("#app, #app-content, #app-webview").height appWindow.getBounds().height

window.NitrousIO = Ember.Application.extend
  rootElement: "#app"

window.AIO = NitrousIO.create
  host: "<%= config['host'] %>"
  clientId: "<%= config['client_id'] %>"
  clientSecret: "<%= config['client_secret'] %>"
  pusherKey: "<%= config['pusher_key'] %>"
  pusherEndpoint: "<%= config['host'] %>/pusher/auth"

  requestFailed: false
  lastRequest: null
  online: true

$(window).on 'online', ->
  window.AIO.set 'online', true

$(window).on 'offline', ->
  window.AIO.set 'online', false

# make Pusher timeline sender no-op
prototype = Pusher.TimelineSender.prototype
prototype.send = ->
