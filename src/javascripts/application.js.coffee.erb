#= require unload-fix
#= require jquery/jquery-2.0.3
#= require handlebars
#= require ember
#= require ember-model/ember-model-0.0.8
#= require pusher/pusher-2.1.2
#= require bootstrap3/js/bootstrap
#= require_self
#= require aio

window.NitrousIO = Em.Application.extend
  rootElement: "#app"
  accessToken: null
  currentUser: null

window.AIO = NitrousIO.create
  host: "<%= config['host'] %>"
  clientId: "<%= config['client_id'] %>"
  clientSecret: "<%= config['client_secret'] %>"
  pusherKey: "<%= config['pusher_key'] %>"
  pusherEndpoint: "<%= config['host'] %>/pusher/auth"
  online: navigator.onLine

$(window).on 'online', ->
  AIO.set 'online', true

$(window).on 'offline', ->
  AIO.set 'online', false

# make Pusher timeline sender no-op
prototype = Pusher.TimelineSender.prototype
prototype.send = ->
